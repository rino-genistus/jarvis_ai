# Jarvis settings. Copy to .env and fill in what you have:
#     cp .env.example .env
# Every key is optional. A service whose key is missing is switched off, and
# Jarvis says so if you ask for it — the rest keeps working.
#
# Needs no key at all: the voice pipeline, memory (on-device), Reminders and
# the everyday tools (dates, Contacts, Apple Calendar, Notes).
# Calendar and Gmail need credentials.json (Google Cloud OAuth client) in this
# folder instead of a key here.

# Weather — https://home.openweathermap.org/api_keys
# Uses One Call API 3.0, which needs the (free-tier) "One Call by Call"
# subscription activated on the account, not just a key.
OPENWEATHER_API_KEY=
# The city used when you ask about the weather without naming one
JARVIS_HOME_LOCATION=

# Web search and research — https://app.tavily.com
TAVILY_API_KEY=

# Spotify — https://developer.spotify.com/dashboard → your app → Settings.
# The redirect URI must match one listed in the app's settings exactly.
# Spotify no longer accepts "localhost"; use the loopback address.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ElevenLabs voice — inactive, reserved for the final release
ELEVENLABS_API_KEY=

# Optional behaviour
# OBSIDIAN_VAULT_PATH=~/Desktop/Jarvis AI
# JARVIS_IDLE_UNLOAD_MINUTES=10
# JARVIS_WAKE_THRESHOLD=0.5
